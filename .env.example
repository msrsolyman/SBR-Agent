# ==========================================
# SBR Agent AI - Environment Configurations
# ==========================================

# General Configuration
PORT=5000
NODE_ENV=development

# Database Setup
MONGO_URI=mongodb://localhost:27017/sbr_agent_ai

# Security & Authentication
JWT_SECRET=super_secret_cyber_security_key_change_me_in_production
JWT_EXPIRE=7d

# Third Party AI Providers (Keys required for production execution)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY_HERE
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE

# Vector Store configurations (Optional)
PINECONE_API_KEY=YOUR_PINECONE_API_KEY_HERE
PINECONE_ENVIRONMENT=us-west1-gcp
CHROMADB_URL=http://localhost:8000

# Payments Integrations (Stripe & SSLCommerz Bangladesh)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

SSLCOMMERZ_STORE_ID=sbr_agent_ai_test
SSLCOMMERZ_STORE_PASSWORD=sbr_agent_ai_test_pass
SSLCOMMERZ_IS_SANDBOX=true

# Notification & Integrations (WhatsApp, Gmail, Telegram, etc.)
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
